spring:
  application:
    name: online-store-api

  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:online_store}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:postgres}

  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
        jdbc:
          time_zone: UTC

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

server:
  port: ${SERVER_PORT:8080}

springdoc:
  swagger-ui:
    path: /swagger-ui.html
    operationsSorter: method
  api-docs:
    path: /v3/api-docs

app:
  jwt:
    secret: ${JWT_SECRET:dev-only-secret-key-please-override-me-before-deploying-anywhere-real-1234567890}
    access-token-expiration-ms: ${JWT_ACCESS_EXP_MS:900000}
    refresh-token-expiration-ms: ${JWT_REFRESH_EXP_MS:604800000}
  stripe:
    secret-key: ${STRIPE_SECRET_KEY:sk_test_replace_me}
    webhook-secret: ${STRIPE_WEBHOOK_SECRET:whsec_replace_me}
    success-url: ${STRIPE_SUCCESS_URL:http://localhost:4200/payment/success}
    cancel-url: ${STRIPE_CANCEL_URL:http://localhost:4200/payment/cancel}

logging:
  level:
    com.code81.onlinestore: DEBUG
    org.hibernate.SQL: DEBUG

# To test Stripe webhooks locally, run this in a separate terminal:
# stripe listen --forward-to localhost:8080/api/payments/webhook